generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  LEARNER
  OWNER
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum SchoolStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  school            School?
  enrollments       Enrollment[]
  reviewsWritten    Review[]
  instructorProfile Instructor?
}

model School {
  id        Int          @id @default(autoincrement())
  name      String
  city      String
  locality  String
  rating    Float        @default(0)
  reviews   Int          @default(0)
  status    SchoolStatus @default(PENDING)

  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   Int      @unique

  courses     Course[]
  enrollments Enrollment[]
  reviewsList Review[]
  instructors Instructor[]
}

model Instructor {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  slots       LessonSlot[]
  enrollments Enrollment[]
}

model Course {
  id       Int    @id @default(autoincrement())
  name     String
  duration String
  price    Int

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  enrollments Enrollment[]
  reviews     Review[]
  slots       LessonSlot[]
}

model Enrollment {
  id          Int              @id @default(autoincrement())
  studentName String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(ACTIVE)

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  user   User? @relation(fields: [userId], references: [id])
  userId Int?

  slot   LessonSlot? @relation(fields: [slotId], references: [id])
  slotId Int?        @unique

  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId Int?
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([courseId, userId])
}

model LessonSlot {
  id       Int      @id @default(autoincrement())
  dateTime DateTime
  isBooked Boolean  @default(false)

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId Int?

  enrollment Enrollment?
}